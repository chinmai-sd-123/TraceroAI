# Settings for running the API and worker outside Docker. Copy to .env at the
# repo root. (Docker Compose doesn't read this file; see infra/docker-compose.yml.)
# Every setting uses the TRACEROAI_ prefix.

# Postgres. Note the +psycopg driver. Create the tables with:
#   cd services/api && python -m app.db.init_db
TRACEROAI_DATABASE_URL=postgresql+psycopg://traceroai:traceroai@localhost:5432/traceroai

# development: readable logs, API keys optional.
# staging/production: JSON logs, API keys required on writes.
TRACEROAI_APP_ENV=development
TRACEROAI_LOG_LEVEL=INFO

# Redis: the deep-evaluation queue and rate limits. Without it, evaluations run
# inside the API process and are lost if it restarts.
TRACEROAI_REDIS_URL=redis://localhost:6379/0

# LLM judge and embeddings (optional). Leave the key empty to score traces with
# the deterministic checks only. Any OpenAI-compatible endpoint works; for
# Gemini set JUDGE_BASE_URL to https://generativelanguage.googleapis.com/v1beta/openai/
# and use Gemini model names.
TRACEROAI_OPENAI_API_KEY=
TRACEROAI_JUDGE_MODEL=gpt-4o-mini
TRACEROAI_EMBEDDING_MODEL=text-embedding-3-small
TRACEROAI_JUDGE_BASE_URL=
TRACEROAI_DEEP_EVAL_ENABLED=true

# Project API keys: a JSON object mapping each key to the project it writes to.
# Generate long random keys, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   TRACEROAI_PROJECT_API_KEYS={"<random key>":"my-app"}
TRACEROAI_PROJECT_API_KEYS={}
# Keys that read every project (JSON list). Give one to the dashboard as its
# TRACEROAI_API_KEY.
TRACEROAI_ADMIN_API_KEYS=[]
# Projects readable without a key when keys are required (JSON list), e.g. a demo.
TRACEROAI_PUBLIC_READ_PROJECTS=[]
# Unset = follow APP_ENV. Set true to require keys in development too.
# TRACEROAI_REQUIRE_API_KEY=true

# Browser origins allowed to call the API (JSON list). localhost:3000 is always allowed.
TRACEROAI_CORS_ORIGINS=[]

# Largest accepted request body, in bytes.
# TRACEROAI_MAX_REQUEST_BYTES=1000000
